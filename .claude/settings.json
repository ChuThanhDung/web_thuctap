{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/_pyrun.cmd scripts/log_hook.py --tool=claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/_pyrun.cmd scripts/log_hook.py --tool=claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/_pyrun.cmd scripts/log_hook.py --tool=claude"
          }
        ]
      }
    ]
  }
}
