# ============================================
# DocuSyncAI environment variables
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env.

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
# text: dễ đọc khi dev; json: một dòng JSON mỗi log (khuyến nghị production, dễ gom log).
LOG_FORMAT=text
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
# Absolute frontend URL used in emails. Leave blank locally to infer from the browser Origin.
APP_FRONTEND_URL=http://localhost:3000

# ---- Backend database for local non-Docker run ----
# Thay <PASSWORD> bằng mật khẩu mạnh (URL-encode ký tự đặc biệt, ví dụ @ -> %40).
DATABASE_URL=postgresql+psycopg://admin:<PASSWORD>@localhost:5433/docusyncai

# ---- File storage ----
# Use local for development. Use r2 on Render after creating a Cloudflare R2 bucket.
STORAGE_PROVIDER=local
STORAGE_BUCKET=docusyncai-uploads
STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=<Access_Key_ID_da_copy>
STORAGE_SECRET_ACCESS_KEY=<Secret_Access_Key_da_copy>
STORAGE_REGION=auto
STORAGE_PRESIGNED_URL_EXPIRATION_SECONDS=1800

# ---- Docker Compose database ----
POSTGRES_USER=admin
# Bắt buộc đặt mật khẩu mạnh; production từ chối khởi động nếu còn dùng Admin@123.
POSTGRES_PASSWORD=<PASSWORD>
POSTGRES_DB=docusyncai
POSTGRES_PORT=5433
DOCKER_DATABASE_URL=postgresql+psycopg://admin:<PASSWORD_URL_ENCODED>@postgres:5432/docusyncai

# ---- Docker Compose ports ----
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1

# ---- Bảo mật ----
# Mật khẩu cho tài khoản seed ban đầu. Bỏ trống: hệ thống tự sinh ngẫu nhiên và ghi log một lần.
# Production yêu cầu tối thiểu 10 ký tự.
SEED_DEFAULT_PASSWORD=
# false: không tạo tài khoản seed (dùng khi đã có người dùng thật).
SEED_DEFAULT_USERS=true
# Giới hạn đăng nhập sai (cửa sổ LOGIN_LOCKOUT_MINUTES).
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_MAX_ATTEMPTS_PER_EMAIL=20
LOGIN_LOCKOUT_MINUTES=15
# Dung lượng tối đa mỗi file upload (byte). Mặc định 20 MB.
MAX_UPLOAD_BYTES=20971520
# Swagger /docs chỉ bật ngoài production; đặt true để bật cả ở production.
DOCS_ENABLED_IN_PRODUCTION=false

# Agent chat mẫu (/api/v1/chat, /api/v1/status). Frontend không dùng; mặc định tắt.
ENABLE_AGENT_CHAT_API=false

# ---- LLM configuration ----
OPENAI_API_KEY=
MODEL_NAME=gpt-5.6-sol
LLM_TEMPERATURE=0.7
OPENAI_DOCUMENT_MODEL=gpt-5.6-sol
# true: neu AI khong doc duoc file thi tu choi upload; false: cho phep fallback offline trong dev/test.
DOCUMENT_AI_VALIDATION_REQUIRED=false

# Gemini (tùy chọn) cho bóc tách PDF/ảnh.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- SMTP email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- LangSmith tracing ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false

# ---- AI Hook Logging ----
AI_LOG_SERVER=
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
